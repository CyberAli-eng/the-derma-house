---
import type { Treatment } from '../data/categories';
interface Props {
  treatment: Treatment;
  showCategory?: string;
}
const { treatment: t, showCategory } = Astro.props;
---

<a class="tcard" href={`/${t.slug}/`} data-category={t.category}>
  {showCategory && <span class="tcard__cat">{showCategory}</span>}
  <span class="tcard__title">{t.title}</span>
  <span class="tcard__summary">{t.summary}</span>
  {t.indications.length > 0 && <span class="tcard__for">For {t.indications.slice(0, 3).join(', ').toLowerCase()}</span>}
</a>

<style>
  .tcard {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    min-height: 100%;
    padding-block: var(--space-lg);
    border-top: 1px solid var(--color-rule);
    color: var(--color-ink);
    text-decoration: none;
  }

  .tcard:hover .tcard__title {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  .tcard:active .tcard__title {
    color: var(--color-accent-deep);
  }

  .tcard__cat {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .tcard__title {
    font-family: var(--font-display);
    font-size: var(--text-title);
    line-height: 1.2;
    transition: color var(--dur-short) var(--ease-out);
  }

  .tcard__summary {
    color: var(--color-ink-2);
  }

  .tcard__for {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
</style>
