---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { clinic, whatsappLink } from '../data/clinic';
import { categories, treatmentsIn, treatments } from '../data/categories';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const links = [
  { href: '/about/', label: 'About' },
  { href: '/case-studies/', label: 'Results' },
  { href: '/food-nutrition/', label: 'Nutrition' },
  { href: '/contact-us/', label: 'Contact' },
];
---

<header class="header" data-header>
  <div class="container header__inner">
    <Logo />

    <nav class="nav" id="mobile-nav" aria-label="Main" data-nav>
      <ul class="nav__list">
        <li class="nav__item nav__item--mega">
          <button type="button" class="nav__link nav__trigger" aria-expanded="false" aria-controls="mega" data-mega-trigger>
            Treatments <Icon name="chevron" size={16} />
          </button>
          <div class="mega" id="mega" data-mega>
            <div class="mega__grid">
              {
                categories.map((c) => (
                  <div class="mega__col">
                    <a class="mega__title" href={`/${c.slug}/`}>{c.title}</a>
                    <ul>
                      {treatmentsIn(c.slug)
                        .slice(0, 6)
                        .map((t) => (
                          <li>
                            <a href={`/${t.slug}/`}>{t.title}</a>
                          </li>
                        ))}
                    </ul>
                  </div>
                ))
              }
            </div>
            <div class="mega__foot">
              <a class="text-link" href="/treatments/">All {treatments.length} treatments</a>
              <a class="text-link" href="/food-nutrition/">Food, nutrition and dietetics</a>
            </div>
          </div>
        </li>
        {
          links.map((l) => (
            <li class="nav__item">
              <a class="nav__link" href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
      <div class="nav__mobile-cta">
        <a class="btn" href="/book-consultation/"><Icon name="calendar" /> Book a consultation</a>
        <a class="btn btn--quiet" href={whatsappLink()} target="_blank" rel="noopener"><Icon name="whatsapp" /> WhatsApp the clinic</a>
        <p class="nav__hours">{clinic.hours.label}. {clinic.hours.note}.</p>
      </div>
    </nav>

    <div class="header__actions">
      <a class="header__phone" href={`tel:${clinic.phoneE164}`}>
        <Icon name="phone" size={18} /> <span>{clinic.phoneDisplay}</span>
      </a>
      <a class="btn header__cta" href="/book-consultation/">Book</a>
      <button type="button" class="menu-btn" aria-expanded="false" aria-controls="mobile-nav" aria-label="Open menu" data-menu>
        <Icon name="menu" size={24} />
      </button>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const menuBtn = document.querySelector<HTMLButtonElement>('[data-menu]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const megaBtn = document.querySelector<HTMLButtonElement>('[data-mega-trigger]');
  const megaItem = megaBtn?.parentElement;

  function setMenu(open: boolean) {
    if (!menuBtn) return;
    if (header) document.documentElement.style.setProperty('--nav-top', `${header.getBoundingClientRect().bottom}px`);
    menuBtn.setAttribute('aria-expanded', String(open));
    menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    nav?.classList.toggle('is-open', open);
    document.body.classList.toggle('menu-open', open);
  }

  function closeMega(returnFocus = false) {
    if (!megaBtn || megaBtn.getAttribute('aria-expanded') !== 'true') return;
    const hadFocus = megaItem?.contains(document.activeElement) && document.activeElement !== megaBtn;
    megaBtn.setAttribute('aria-expanded', 'false');
    if (returnFocus && hadFocus) megaBtn.focus();
  }

  menuBtn?.addEventListener('click', () => setMenu(menuBtn.getAttribute('aria-expanded') !== 'true'));

  megaBtn?.addEventListener('click', () => {
    const open = megaBtn.getAttribute('aria-expanded') !== 'true';
    megaBtn.setAttribute('aria-expanded', String(open));
  });

  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    closeMega(true);
    if (menuBtn?.getAttribute('aria-expanded') === 'true') {
      setMenu(false);
      menuBtn.focus();
    }
  });

  megaItem?.addEventListener('focusout', (e) => {
    const next = (e as FocusEvent).relatedTarget as Node | null;
    if (next && !megaItem.contains(next)) closeMega();
  });

  document.addEventListener('click', (e) => {
    if (megaItem && !megaItem.contains(e.target as Node)) closeMega();
  });

  window.matchMedia('(min-width: 1081px)').addEventListener('change', (e) => {
    if (e.matches) setMenu(false);
  });
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-sticky-nav);
    background: var(--color-field);
    color: var(--color-field-ink);
    border-bottom: 1px solid var(--color-field-rule);
  }

  .header :global(:focus-visible) {
    outline-color: var(--color-seal);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    min-height: var(--nav-h);
  }

  .nav__list {
    display: flex;
    align-items: center;
    gap: var(--space-2xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2xs);
    min-height: 44px;
    padding: var(--space-xs) var(--space-sm);
    border: 0;
    border-radius: var(--radius-input);
    background: none;
    color: var(--color-field-ink);
    font: 400 var(--text-md) var(--font-body);
    text-decoration: none;
    cursor: pointer;
    transition: color var(--dur-short) var(--ease-out), background-color var(--dur-short) var(--ease-out);
  }

  .nav__link:hover {
    color: var(--color-seal);
  }

  .nav__link:active {
    background: var(--color-field-2);
  }

  .nav__link[aria-current='page'] {
    color: var(--color-seal);
    text-decoration: underline;
    text-underline-offset: 0.4em;
  }

  .nav__trigger svg {
    transition: transform var(--dur-short) var(--ease-out);
  }

  .nav__trigger[aria-expanded='true'] svg {
    transform: rotate(180deg);
  }

  .mega {
    position: absolute;
    left: 50%;
    top: 100%;
    width: min(100% - 2 * var(--gutter), var(--container) - 2 * var(--gutter));
    transform: translateX(-50%);
    padding: var(--space-xl);
    background: var(--color-paper);
    color: var(--color-ink);
    border: 1px solid var(--color-rule);
    border-top: 0;
    border-radius: 0 0 var(--radius-card) var(--radius-card);
    display: none;
  }

  .mega :global(:focus-visible) {
    outline-color: var(--color-focus);
  }

  [aria-expanded='true'] + .mega {
    display: block;
  }

  .mega__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-xl) var(--gap-columns);
  }

  .mega__title {
    display: block;
    margin-bottom: var(--space-xs);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--color-ink);
    text-decoration: none;
  }

  .mega__title:hover {
    color: var(--color-accent);
  }

  .mega ul {
    display: grid;
    gap: var(--space-2xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .mega li a {
    font-size: var(--text-sm);
    color: var(--color-ink-2);
    text-decoration: none;
  }

  .mega li a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .mega__foot {
    display: flex;
    gap: var(--space-xl);
    margin-top: var(--space-xl);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-rule);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-md);
  }

  .header__phone {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    min-height: 44px;
    color: var(--color-field-ink);
    text-decoration: none;
    white-space: nowrap;
  }

  .header__phone:hover {
    color: var(--color-seal);
  }

  .header .header__cta {
    min-height: 44px;
    border-color: var(--color-seal);
    background: var(--color-seal);
    color: var(--color-ink);
  }

  .header .header__cta:hover {
    background: var(--color-field-ink);
    color: var(--color-ink);
  }

  .menu-btn {
    display: none;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: var(--radius-input);
    background: none;
    color: var(--color-field-ink);
    cursor: pointer;
  }

  .menu-btn:active {
    background: var(--color-field-2);
  }

  .nav__mobile-cta {
    display: none;
  }

  @media (max-width: 1080px) {
    .menu-btn {
      display: grid;
    }

    .header__phone span,
    .header .header__cta {
      display: none;
    }

    .nav {
      position: fixed;
      inset: var(--nav-top, var(--nav-h)) 0 0 0;
      padding: var(--space-md) var(--gutter) var(--space-2xl);
      overflow-y: auto;
      background: var(--color-paper);
      color: var(--color-ink);
      display: none;
    }

    .nav.is-open {
      display: block;
    }

    .nav :global(:focus-visible) {
      outline-color: var(--color-focus);
    }

    .nav__list {
      flex-direction: column;
      align-items: stretch;
    }

    .nav__link {
      width: 100%;
      justify-content: space-between;
      padding: var(--space-md) var(--space-2xs);
      border-radius: 0;
      border-bottom: 1px solid var(--color-rule);
      color: var(--color-ink);
      font-size: var(--text-lg);
    }

    .nav__link:hover,
    .nav__link[aria-current='page'] {
      color: var(--color-accent);
    }

    .nav__link:active {
      background: var(--color-paper-2);
    }

    .mega {
      position: static;
      transform: none;
      width: auto;
      padding: var(--space-xs) 0 var(--space-md);
      border: 0;
      background: transparent;
    }

    .mega__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-2xs);
    }

    .mega ul,
    .mega__foot {
      display: none;
    }

    .mega__title {
      padding: var(--space-xs) var(--space-sm);
      font-family: var(--font-body);
      font-size: var(--text-md);
    }

    .nav__mobile-cta {
      display: grid;
      gap: var(--space-sm);
      margin-top: var(--space-xl);
    }

    .nav__hours {
      font-size: var(--text-sm);
      color: var(--color-muted);
    }
  }
</style>
