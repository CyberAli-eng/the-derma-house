---
import Base from '../layouts/Base.astro';
import PageHero from './PageHero.astro';
import BookingForm from './BookingForm.astro';
import FaqList from './FaqList.astro';
import TreatmentCard from './TreatmentCard.astro';
import Icon from './Icon.astro';
import CtaBand from './CtaBand.astro';
import { treatmentBySlug, categoryBySlug, treatmentsIn, treatmentExtras } from '../data/categories';
import { clinic, whatsappLink } from '../data/clinic';

interface Props {
  slug: string;
}
const t = treatmentBySlug(Astro.props.slug);
if (!t) throw new Error(`Unknown treatment: ${Astro.props.slug}`);
const category = categoryBySlug(t.category)!;
const related = treatmentsIn(t.category).filter((x) => x.slug !== t.slug).slice(0, 3);
const extra = treatmentExtras[t.slug];
const details = t.sections.slice(1);

const description = `${t.summary} ${t.title} at The Derma House, Kaithal: personalised plans by certified dermatologists.`.slice(0, 158);
const schema: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'MedicalProcedure',
    name: t.title,
    description: t.summary,
    url: `${clinic.site}/${t.slug}/`,
    relevantSpecialty: 'Dermatology',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: clinic.site + '/' },
      { '@type': 'ListItem', position: 2, name: category.title, item: `${clinic.site}/${category.slug}/` },
      { '@type': 'ListItem', position: 3, name: t.title, item: `${clinic.site}/${t.slug}/` },
    ],
  },
];
if (t.faq.length) {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: t.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  });
}
---

<Base title={`${t.title} in Kaithal`} description={description} image={category.image} schema={schema}>
  <PageHero
    title={t.title}
    lede={t.summary}
    crumbs={[{ label: category.title, href: `/${category.slug}/` }, { label: t.title }]}
    image={category.image}
    imageAlt={category.imageAlt}
  >
    {
      t.indications.length > 0 && (
        <div class="indications">
          <p class="label">Recommended for</p>
          <ul class="chips">
            {t.indications.map((i) => (
              <li class="chip">{i}</li>
            ))}
          </ul>
        </div>
      )
    }
  </PageHero>

  <section class="section">
    <div class="container layout">
      <article class="detail">
        <h2 class="detail__h">What to expect</h2>
        <dl class="facts">
          {
            details.map((s) => (
              <div class="fact">
                <dt>{s.heading}</dt>
                <dd>{s.body}</dd>
              </div>
            ))
          }
        </dl>

        {
          extra && (
            <div class="extra">
              <h2 class="detail__h">{extra.heading}</h2>
              <ul class="extra__list">
                {extra.items.map((i) => (
                  <li>{i}</li>
                ))}
              </ul>
            </div>
          )
        }

        <p class="consult">
          <strong>The dermatologist checks first.</strong> Results depend on your skin type and condition. At your
          consultation the doctor goes through your medical history and tells you whether {t.title.toLowerCase()} suits you,
          what it involves and what aftercare it needs.
        </p>

        {
          t.faq.length > 0 && (
            <div class="detail__faq">
              <h2 class="detail__h">Questions about {t.title.toLowerCase()}</h2>
              <FaqList items={t.faq} />
            </div>
          )
        }
      </article>

      <aside class="side">
        <BookingForm title={`Book ${t.title.toLowerCase()}`} preset={category.title} compact />
        <ul class="side__quick">
          <li><a href={`tel:${clinic.phoneE164}`}><Icon name="phone" size={18} /> {clinic.phoneDisplay}</a></li>
          <li>
            <a href={whatsappLink(`Hello, I would like to know more about ${t.title}.`)} target="_blank" rel="noopener">
              <Icon name="whatsapp" size={18} /> Ask on WhatsApp
            </a>
          </li>
          <li><Icon name="clock" size={18} /> {clinic.hours.label}</li>
        </ul>
      </aside>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="section well">
        <div class="container">
          <div class="head head--split">
            <h2>More {category.title.toLowerCase()}</h2>
            <p>
              <a class="text-link" href={`/${category.slug}/`}>
                All {category.title.toLowerCase()}
              </a>
            </p>
          </div>
          <div class="grid grid--3">
            {related.map((r) => (
              <TreatmentCard treatment={r} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <CtaBand />
</Base>

<style>
  .indications {
    display: grid;
    gap: var(--space-xs);
  }

  .layout {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-3xl);
    align-items: start;
  }

  .side {
    position: sticky;
    top: calc(var(--nav-h) + var(--space-lg));
    display: grid;
    gap: var(--space-lg);
  }

  .side__quick {
    display: grid;
    gap: var(--space-sm);
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--color-ink-2);
  }

  .side__quick li,
  .side__quick a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .side__quick a {
    min-height: 44px;
    color: var(--color-accent);
    font-weight: 700;
  }

  .detail__h {
    margin-bottom: var(--space-lg);
    font-size: var(--text-section);
  }

  .facts {
    margin: 0 0 var(--space-2xl);
    border-top: 1px solid var(--color-rule);
  }

  .fact {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 5fr);
    gap: var(--space-xs) var(--gap-columns);
    padding-block: var(--space-lg);
    border-bottom: 1px solid var(--color-rule);
  }

  .fact dt {
    font-family: var(--font-display);
    font-size: var(--text-title);
    line-height: 1.2;
  }

  .fact dd {
    margin: 0;
    font-size: var(--text-lead);
    line-height: 1.5;
    color: var(--color-ink-2);
  }

  .extra {
    margin-bottom: var(--space-2xl);
  }

  .extra__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-sm) var(--gap-columns);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .extra__list li {
    padding: var(--space-md) 0;
    border-top: 2px solid var(--color-accent);
    font-weight: 700;
  }

  .consult {
    max-width: 62ch;
    margin-bottom: var(--space-2xl);
    padding: var(--space-lg);
    background: var(--color-paper-2);
    border-radius: var(--radius-card);
    color: var(--color-ink-2);
  }

  .consult strong {
    color: var(--color-ink);
  }

  @media (max-width: 60rem) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .side {
      position: static;
    }

    .fact {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 40rem) {
    .extra__list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
