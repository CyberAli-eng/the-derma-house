---
// The page close: what a visitor needs to act (book, call, WhatsApp, hours), on the navy band.
import Icon from './Icon.astro';
import { clinic, fullAddress, whatsappLink } from '../data/clinic';
interface Props {
  title?: string;
}
const { title = 'Book a consultation' } = Astro.props;
---

<section class="section--s band close">
  <div class="container close__grid">
    <div>
      <h2>{title}</h2>
      <p class="lead">{clinic.hours.label}. {clinic.hours.note}. {fullAddress}.</p>
    </div>
    <div class="close__actions">
      <a class="btn" href="/book-consultation/"><Icon name="calendar" /> Book a consultation</a>
      <a class="btn btn--quiet" href={whatsappLink()} target="_blank" rel="noopener"><Icon name="whatsapp" /> WhatsApp</a>
      <a class="btn btn--quiet" href={`tel:${clinic.phoneE164}`}><Icon name="phone" /> {clinic.phoneDisplay}</a>
    </div>
  </div>
</section>

<style>
  .close__grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    gap: var(--space-xl) var(--gap-columns);
    align-items: center;
  }

  .close .lead {
    margin-top: var(--space-md);
  }

  .close__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    justify-content: flex-end;
  }

  @media (max-width: 60rem) {
    .close__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .close__actions {
      justify-content: flex-start;
    }
  }
</style>
