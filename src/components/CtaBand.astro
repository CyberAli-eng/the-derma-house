---
import Icon from './Icon.astro';
import { clinic, whatsappLink } from '../data/clinic';
interface Props {
  title?: string;
  body?: string;
}
const {
  title = 'Ready to transform your skin and hair?',
  body = 'Take the first step toward clearer skin, fuller hair and renewed confidence. Book a consultation in person or online.',
} = Astro.props;
---

<section class="cta">
  <div class="wrap cta__inner">
    <div>
      <h2>{title}</h2>
      <p>{body}</p>
    </div>
    <div class="cta__actions">
      <a class="btn btn--gold" href="/book-consultation/"><Icon name="calendar" /> Book consultation</a>
      <a class="btn btn--light" href={whatsappLink()} target="_blank" rel="noopener"><Icon name="whatsapp" /> WhatsApp</a>
      <a class="cta__phone" href={`tel:${clinic.phoneE164}`}><Icon name="phone" size={18} /> {clinic.phoneDisplay}</a>
    </div>
  </div>
</section>

<style>
  .cta {
    padding-block: clamp(40px, 6vw, 72px);
  }

  .cta__inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 32px;
    align-items: center;
    padding: clamp(32px, 5vw, 64px);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(120% 140% at 100% 0%, rgb(180 138 60 / 0.28), transparent 55%),
      var(--navy);
    color: #c9dae5;
    overflow: hidden;
  }

  .cta h2 {
    color: var(--white);
    margin-bottom: 12px;
  }

  .cta p {
    margin: 0;
    max-width: 52ch;
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: flex-end;
    align-items: center;
  }

  .cta__phone {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--white);
    text-decoration: none;
    font-weight: 700;
    padding: 8px 4px;
  }

  @media (max-width: 860px) {
    .cta__inner {
      grid-template-columns: 1fr;
    }

    .cta__actions {
      justify-content: flex-start;
    }
  }
</style>
