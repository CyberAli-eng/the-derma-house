---
interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  title: string;
  lede?: string;
  crumbs?: Crumb[];
  image?: string;
  imageAlt?: string;
  imageSize?: [number, number];
}
const { title, lede, crumbs = [], image, imageAlt = '', imageSize = [900, 900] } = Astro.props;
---

<section class:list={['phero', { 'phero--img': image }]}>
  <div class="container phero__grid">
    <div class="phero__text">
      {
        crumbs.length > 0 && (
          <nav class="crumbs" aria-label="Breadcrumb">
            <ol>
              <li>
                <a href="/">Home</a>
              </li>
              {crumbs.map((c) => (
                <li>{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</li>
              ))}
            </ol>
          </nav>
        )
      }
      <h1>{title}</h1>
      {lede && <p class="lead">{lede}</p>}
      <slot />
    </div>
    {
      image && (
        <figure class="photo phero__photo" data-slot="page-hero" data-alt={imageAlt}>
          <img src={image} alt={imageAlt} width={imageSize[0]} height={imageSize[1]} fetchpriority="high" />
        </figure>
      )
    }
  </div>
</section>

<style>
  .phero {
    padding-block: var(--space-3xl) var(--space-2xl);
    border-bottom: 1px solid var(--color-rule);
  }

  .phero__grid {
    display: grid;
    gap: var(--space-3xl);
    align-items: center;
  }

  .phero--img .phero__grid {
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    min-height: calc(72svh - var(--nav-h));
  }

  .phero__text {
    display: grid;
    gap: var(--space-lg);
    align-content: center;
  }

  .phero h1 {
    max-width: 16ch;
  }

  .phero__photo {
    aspect-ratio: 4 / 3;
    max-height: 62svh;
    width: 100%;
  }

  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .crumbs li + li::before {
    content: '/';
    margin-right: var(--space-xs);
    color: var(--color-rule);
  }

  .crumbs a {
    color: var(--color-ink-2);
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  @media (max-width: 60rem) {
    .phero--img .phero__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-xl);
      min-height: 0;
    }
  }
</style>
