---
import Base from '../layouts/Base.astro';
import PageHero from './PageHero.astro';
import CtaBand from './CtaBand.astro';
import { categoryBySlug, treatmentsIn, categories } from '../data/categories';
import { clinic } from '../data/clinic';

interface Props {
  slug: string;
}
const category = categoryBySlug(Astro.props.slug);
if (!category) throw new Error(`Unknown category: ${Astro.props.slug}`);
const items = treatmentsIn(category.slug);
const others = categories.filter((c) => c.slug !== category.slug);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: clinic.site + '/' },
      { '@type': 'ListItem', position: 2, name: category.title, item: `${clinic.site}/${category.slug}/` },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: `${category.title} at ${clinic.name}`,
    itemListElement: items.map((t, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `${clinic.site}/${t.slug}/`,
      name: t.title,
    })),
  },
];
---

<Base
  title={`${category.title} in Kaithal`}
  description={`${category.intro.slice(0, 140)} Book at The Derma House, Kaithal.`}
  image={category.image}
  schema={schema}
>
  <PageHero
    title={category.title}
    lede={category.intro}
    crumbs={[{ label: 'Treatments', href: '/treatments/' }, { label: category.title }]}
    image={category.image}
    imageAlt={category.imageAlt}
  >
    <div class="actions">
      <a class="btn" href="/book-consultation/">Book a consultation</a>
      <a class="btn btn--quiet" href={`tel:${clinic.phoneE164}`}>Call {clinic.phoneDisplay}</a>
    </div>
  </PageHero>

  <section class="section">
    <div class="container cat">
      <h2>{items.length} treatments</h2>
      <ul class="cat__rows">
        {
          items.map((t) => (
            <li>
              <a class="cat__name" href={`/${t.slug}/`}>
                {t.title}
              </a>
              <p class="cat__summary">{t.summary}</p>
              {t.indications.length > 0 && <p class="cat__for">For {t.indications.join(', ').toLowerCase()}</p>}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section--s well">
    <div class="container others">
      <h2 class="others__h">Other specialities</h2>
      <ul class="chips">
        {others.map((c) => <li><a class="chip" href={`/${c.slug}/`}>{c.title}</a></li>)}
        <li><a class="chip" href="/food-nutrition/">Food, Nutrition and Dietetics</a></li>
      </ul>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .cat {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: var(--space-xl) var(--gap-columns);
    align-items: start;
  }

  .cat__rows {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-rule);
  }

  .cat__rows li {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-2xs) var(--gap-columns);
    padding-block: var(--space-lg);
    border-bottom: 1px solid var(--color-rule);
  }

  .cat__name {
    grid-row: span 2;
    font-family: var(--font-display);
    font-size: var(--text-title);
    line-height: 1.2;
    color: var(--color-ink);
    text-decoration: none;
  }

  .cat__name:hover {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  .cat__summary {
    color: var(--color-ink-2);
  }

  .cat__for {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .others {
    display: grid;
    gap: var(--space-lg);
  }

  .others__h {
    font-size: var(--text-2xl);
  }

  @media (max-width: 60rem) {
    .cat,
    .cat__rows li {
      grid-template-columns: minmax(0, 1fr);
    }

    .cat__name {
      grid-row: auto;
    }
  }
</style>
