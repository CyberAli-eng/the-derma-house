---
// Typographic recreation of the gold crest logo. Swap for the clinic's SVG logo
// file (public/logo.svg) once the original vector is supplied.
interface Props {
  tone?: 'light' | 'dark';
}
const { tone = 'dark' } = Astro.props;
---

<a href="/" class:list={['logo', `logo--${tone}`]} aria-label="The Derma House, home">
  <svg class="logo__mark" viewBox="0 0 40 40" aria-hidden="true">
    <path d="M4 38V20a16 16 0 0 1 32 0v18" fill="none" stroke="currentColor" stroke-width="1.6" />
    <path d="M10 38V21a10 10 0 0 1 20 0v17" fill="none" stroke="currentColor" stroke-width="1" opacity=".6" />
    <path d="M20 11c-3 3-3.5 7-1 10.5 2.2 3 1.8 6.8-1 9.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
  </svg>
  <span class="logo__text">
    <span class="logo__by">Dr. Aanchal S. Kakkar’s</span>
    <span class="logo__name">The Derma House</span>
    <span class="logo__tag">Skin · Laser · Hair Transplant</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    line-height: 1;
  }

  .logo__mark {
    width: 38px;
    height: 38px;
    color: var(--gold);
    flex: none;
  }

  .logo__text {
    display: grid;
    gap: 3px;
  }

  .logo__by {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 0.78rem;
    color: var(--gold-600);
  }

  .logo__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.45rem;
    letter-spacing: 0.01em;
    color: var(--navy-900);
  }

  .logo__tag {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .logo__name,
  .logo__tag {
    white-space: nowrap;
  }

  @media (max-width: 420px) {
    .logo__mark {
      width: 30px;
      height: 30px;
    }

    .logo__name {
      font-size: 1.2rem;
    }

    .logo__tag {
      font-size: 0.52rem;
      letter-spacing: 0.12em;
    }
  }

  .logo--light .logo__name {
    color: var(--white);
  }

  .logo--light .logo__by {
    color: var(--gold-soft);
  }

  .logo--light .logo__tag {
    color: #a9c0cf;
  }
</style>
