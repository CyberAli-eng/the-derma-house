---
// The clinic's own crest logo (gold and white, drawn for a navy ground), taken from dermahouseclinic.com.
interface Props {
  size?: 'nav' | 'mast';
}
const { size = 'nav' } = Astro.props;
---

<a href="/" class:list={['logo', `logo--${size}`]} aria-label="The Derma House, home">
  <img
    src="/images/logo.png"
    alt="Dr. Aanchal S. Kakkar’s The Derma House: Skin, Laser, Hair Transplant"
    width="500"
    height="222"
    decoding="async"
  />
</a>

<style>
  .logo {
    display: inline-flex;
    flex-shrink: 0;
    border-radius: var(--radius-input);
  }

  .logo img {
    width: auto;
  }

  .logo--nav img {
    height: 56px;
  }

  .logo--mast img {
    height: 112px;
  }

  @media (max-width: 40rem) {
    .logo--nav img {
      height: 46px;
    }

    .logo--mast img {
      height: 88px;
    }
  }
</style>
