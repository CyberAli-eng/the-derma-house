---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { clinic, fullAddress, whatsappLink } from '../data/clinic';
import { categories } from '../data/categories';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer__mast">
      <Logo size="mast" />
      <p class="footer__line">Skin, laser and hair transplant clinic in Kaithal, run by {clinic.legalName}.</p>
    </div>

    <div class="footer__grid">
      <nav aria-label="Treatments">
        <h2 class="footer__h">Treatments</h2>
        <ul>
          {categories.map((c) => <li><a href={`/${c.slug}/`}>{c.title}</a></li>)}
          <li><a href="/hair-transplant/">Hair Transplant</a></li>
          <li><a href="/food-nutrition/">Food, Nutrition and Dietetics</a></li>
        </ul>
      </nav>

      <nav aria-label="Clinic">
        <h2 class="footer__h">Clinic</h2>
        <ul>
          <li><a href="/about/">About the clinic</a></li>
          <li><a href="/case-studies/">Before and after</a></li>
          <li><a href="/book-consultation/">Book a consultation</a></li>
          <li><a href="/contact-us/">Contact</a></li>
        </ul>
      </nav>

      <div>
        <h2 class="footer__h">Visit</h2>
        <address class="footer__address">
          <span>{fullAddress}</span>
          <a href={clinic.mapsLink} target="_blank" rel="noopener">Get directions</a>
          <span>{clinic.hours.label}</span>
          <span>{clinic.hours.note}</span>
          <a href={`tel:${clinic.phoneE164}`}>{clinic.phoneDisplay}</a>
          <a href={`mailto:${clinic.email}`}>{clinic.email}</a>
        </address>
      </div>

      <div>
        <h2 class="footer__h">Follow</h2>
        <ul class="footer__social">
          <li><a href={clinic.social.instagram} target="_blank" rel="noopener"><Icon name="instagram" size={20} /> Instagram</a></li>
          <li><a href={clinic.social.facebook} target="_blank" rel="noopener"><Icon name="facebook" size={20} /> Facebook</a></li>
          <li><a href={whatsappLink()} target="_blank" rel="noopener"><Icon name="whatsapp" size={20} /> WhatsApp</a></li>
        </ul>
      </div>
    </div>

    <div class="footer__base">
      <p>© {year} {clinic.name}. Information on this site is general and does not replace a consultation with a dermatologist.</p>
      <ul>
        <li><a href="/terms-of-service/">Terms of service</a></li>
        <li><a href="/privacy-policy/">Privacy policy</a></li>
        <li><a href="/refund-return-policy/">Refund policy</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-top: var(--space-3xl);
    background: var(--color-field);
    color: var(--color-field-muted);
    font-size: var(--text-sm);
  }

  .footer :global(:focus-visible) {
    outline-color: var(--color-seal);
  }

  .footer__mast {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-lg);
    padding-bottom: var(--space-2xl);
    border-bottom: 1px solid var(--color-field-rule);
  }

  .footer__line {
    max-width: 34ch;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.3;
    color: var(--color-field-ink);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-xl) var(--gap-columns);
    padding-block: var(--space-2xl);
  }

  .footer__h {
    max-width: none;
    margin-bottom: var(--space-md);
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 700;
    letter-spacing: 0;
    color: var(--color-field-ink);
  }

  .footer ul {
    display: grid;
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer a {
    color: var(--color-field-muted);
    text-decoration: none;
    transition: color var(--dur-short) var(--ease-out);
  }

  .footer a:hover {
    color: var(--color-seal);
    text-decoration: underline;
  }

  .footer__address {
    display: grid;
    gap: var(--space-xs);
    font-style: normal;
  }

  .footer__social a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
  }

  .footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-sm) var(--space-xl);
    padding-block: var(--space-lg) var(--space-3xl);
    border-top: 1px solid var(--color-field-rule);
  }

  .footer__base ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-lg);
  }

  @media (max-width: 60rem) {
    .footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 40rem) {
    .footer__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (min-width: 1081px) {
    .footer__base {
      padding-bottom: var(--space-xl);
    }
  }
</style>
