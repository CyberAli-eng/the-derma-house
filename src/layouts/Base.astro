---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { clinic, whatsappLink } from '../data/clinic';
import { img } from '../data/categories';

interface Props {
  title: string;
  description: string;
  image?: string;
  schema?: Record<string, unknown>[];
  noindex?: boolean;
}

const { title, description, image = img.hero, schema = [], noindex: pageNoindex = false } = Astro.props;
// Preview/staging builds set PUBLIC_NOINDEX=true so search engines never index a copy of the live site.
const noindex = pageNoindex || import.meta.env.PUBLIC_NOINDEX === 'true';
const canonical = new URL(Astro.url.pathname, clinic.site).href;
const ogImage = new URL(image, clinic.site).href;
const fullTitle = title.includes(clinic.name) ? title : `${title} | ${clinic.name}, Kaithal`;

const clinicSchema = {
  '@context': 'https://schema.org',
  '@type': ['MedicalClinic', 'LocalBusiness'],
  '@id': `${clinic.site}/#clinic`,
  name: clinic.name,
  legalName: clinic.legalName,
  url: clinic.site,
  telephone: clinic.phoneE164,
  email: clinic.email,
  image: new URL(img.hero, clinic.site).href,
  logo: new URL('/images/logo.png', clinic.site).href,
  medicalSpecialty: 'Dermatology',
  address: {
    '@type': 'PostalAddress',
    streetAddress: clinic.address.line1,
    addressLocality: clinic.address.city,
    addressRegion: clinic.address.region,
    postalCode: clinic.address.postalCode,
    addressCountry: clinic.address.country,
  },
  openingHours: clinic.hours.schema,
  hasMap: clinic.mapsLink,
  sameAs: [clinic.social.instagram, clinic.social.facebook],
};
const jsonLd = [clinicSchema, ...schema];
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#00314d" />
    <link rel="icon" href="/images/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/images/favicon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={clinic.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Libre+Caslon+Display&family=Lato:wght@400;700&display=swap"
    />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <a class="wa-float" href={whatsappLink()} target="_blank" rel="noopener" aria-label="Chat with us on WhatsApp">
      <Icon name="whatsapp" size={26} />
    </a>

    <nav class="mobile-bar" aria-label="Quick contact">
      <a href={`tel:${clinic.phoneE164}`}><Icon name="phone" /> Call</a>
      <a href={whatsappLink()} target="_blank" rel="noopener"><Icon name="whatsapp" /> WhatsApp</a>
      <a class="mobile-bar__book" href="/book-consultation/"><Icon name="calendar" /> Book</a>
    </nav>

    <script>
      const els = document.querySelectorAll<HTMLElement>('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            });
          },
          { rootMargin: '0px 0px -8% 0px' },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-in'));
      }

      // A cross-origin iframe (the map) never matches :focus once focus moves inside it,
      // so mark it while it holds focus and draw the ring from that class.
      const markFrame = () => {
        document.querySelectorAll('iframe.is-focused').forEach((f) => f.classList.remove('is-focused'));
        const active = document.activeElement;
        if (active instanceof HTMLIFrameElement) active.classList.add('is-focused');
      };
      window.addEventListener('blur', () => setTimeout(markFrame, 0));
      window.addEventListener('focus', markFrame);
    </script>

    <style is:global>
      body.menu-open {
        overflow: hidden;
      }

      .wa-float {
        position: fixed;
        right: var(--space-lg);
        bottom: var(--space-lg);
        z-index: var(--z-sticky);
        display: grid;
        place-items: center;
        width: 56px;
        height: 56px;
        border-radius: var(--radius-pill);
        background: var(--color-whatsapp);
        color: var(--color-whatsapp-ink);
        transition: transform var(--dur-micro) var(--ease-out);
      }

      .wa-float:hover {
        color: var(--color-whatsapp-ink);
        transform: translateY(-2px);
      }

      .wa-float:active {
        transform: translateY(0);
      }

      .mobile-bar {
        display: none;
      }

      @media (max-width: 1080px) {
        .wa-float {
          display: none;
        }

        .mobile-bar {
          position: fixed;
          inset: auto 0 0 0;
          z-index: var(--z-sticky);
          display: grid;
          grid-template-columns: repeat(3, minmax(0, 1fr));
          gap: var(--space-xs);
          padding: var(--space-xs) var(--space-sm) calc(var(--space-xs) + env(safe-area-inset-bottom));
          background: var(--color-paper);
          border-top: 1px solid var(--color-rule);
        }

        .mobile-bar a {
          display: inline-flex;
          align-items: center;
          justify-content: center;
          gap: var(--space-xs);
          min-height: 48px;
          border: 1px solid var(--color-rule);
          border-radius: var(--radius-input);
          font-weight: 700;
          font-size: var(--text-sm);
          color: var(--color-ink);
          text-decoration: none;
        }

        .mobile-bar a:active {
          background: var(--color-paper-2);
        }

        .mobile-bar .mobile-bar__book {
          background: var(--color-accent);
          border-color: var(--color-accent);
          color: var(--color-accent-ink);
        }

        body {
          padding-bottom: 72px;
        }
      }
    </style>
  </body>
</html>
