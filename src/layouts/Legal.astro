---
import Base from './Base.astro';
import PageHero from '../components/PageHero.astro';

const { frontmatter } = Astro.props;
---

<Base title={frontmatter.title} description={frontmatter.description}>
  <PageHero title={frontmatter.title} eyebrow={`Effective ${frontmatter.effective}`} crumbs={[{ label: frontmatter.title }]} />
  <section class="section">
    <div class="wrap legal prose">
      <slot />
    </div>
  </section>
</Base>

<style>
  .legal {
    max-width: 780px;
  }

  .legal :global(h2:first-child) {
    margin-top: 0;
  }
</style>
