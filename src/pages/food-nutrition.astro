---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { nutritionist, nutritionTopics, nutritionSupport } from '../data/content';
import { img } from '../data/categories';
import { whatsappLink } from '../data/clinic';
---

<Base
  title="Food, Nutrition & Dietetics"
  description="Diet plans from Dt. Maheep Dhaliwal, Clinical Nutritionist at The Derma House, Kaithal, for healthy skin, hair, weight and hormonal health."
  image={img.nutritionist}
>
  <PageHero
    title="Diet plans from Dt. Maheep Dhaliwal"
    lede={`${nutritionist.qualification}. ${nutritionist.role} at The Derma House.`}
    crumbs={[{ label: 'Food, Nutrition and Dietetics' }]}
    image={img.nutritionist}
    imageAlt="Dt. Maheep Dhaliwal in a white coat at the clinic"
    imageSize={[900, 1352]}
  >
    <div class="actions">
      <a class="btn" href={whatsappLink('Hello, I would like to book a nutrition consultation with Dt. Maheep Dhaliwal.')} target="_blank" rel="noopener">
        <Icon name="whatsapp" /> Book a nutrition consult
      </a>
    </div>
  </PageHero>

  <section class="section">
    <div class="container nutri">
      <p class="nutri__bio">{nutritionist.bio}</p>
      <dl class="nutri__rows">
        {
          nutritionTopics.map((t) => (
            <div>
              <dt>{t.title}</dt>
              <dd>{t.body}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section--s well">
    <div class="container support">
      <h2 class="support__h">Plans for</h2>
      <ul class="support__list">
        {nutritionSupport.map((s) => <li>{s}</li>)}
      </ul>
    </div>
  </section>

  <CtaBand title="Book with the nutritionist" />
</Base>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  :global(.phero__photo img) {
    object-position: 50% 12%;
  }

  .nutri {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    gap: var(--space-3xl);
    align-items: start;
  }

  .nutri__bio {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    line-height: 1.3;
  }

  .nutri__rows {
    margin: 0;
    border-top: 1px solid var(--color-rule);
  }

  .nutri__rows div {
    padding-block: var(--space-lg);
    border-bottom: 1px solid var(--color-rule);
  }

  .nutri__rows dt {
    font-weight: 700;
  }

  .nutri__rows dd {
    margin: var(--space-2xs) 0 0;
    color: var(--color-ink-2);
  }

  .support {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    gap: var(--space-lg) var(--gap-columns);
    align-items: center;
  }

  .support__h {
    font-size: var(--text-2xl);
  }

  .support__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--gap-columns);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .support__list li {
    padding-top: var(--space-sm);
    border-top: 2px solid var(--color-accent);
    font-family: var(--font-display);
    font-size: var(--text-title);
  }

  @media (max-width: 60rem) {
    .nutri,
    .support {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-xl);
    }

    .support__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
