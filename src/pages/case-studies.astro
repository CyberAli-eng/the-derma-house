---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { caseStudies, testimonials } from '../data/content';
import { clinic } from '../data/clinic';
const total = caseStudies.reduce((n, g) => n + g.items.length, 0);
---

<Base
  title="Results & Case Studies"
  description="Real treatment outcomes from The Derma House, Kaithal: laser, derma-surgical, hair restoration and anti-ageing case studies."
>
  <PageHero
    title="Results & case studies"
    eyebrow={`${total} documented case types`}
    lede="A selection of the cases our team treats regularly. Before-and-after photos are shared with patient consent on our Instagram and during your consultation."
    crumbs={[{ label: 'Results' }]}
  >
    <a class="btn ig" href={clinic.social.instagram} target="_blank" rel="noopener"><Icon name="instagram" /> See results on Instagram</a>
  </PageHero>

  <section class="section">
    <div class="wrap groups">
      {
        caseStudies.map((g) => (
          <section class="group card reveal">
            <h2>{g.group}</h2>
            <ul>
              {g.items.map((i) => (
                <li>
                  <Icon name="check" size={16} /> {i}
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </section>

  <section class="section section--ice">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">In their words</p>
        <h2>Patient feedback</h2>
      </div>
      <div class="grid grid--3">
        {
          testimonials.map((t) => (
            <figure class="card fb">
              <blockquote>“{t.quote}”</blockquote>
              <figcaption>
                <strong>{t.name}</strong> · {t.treatment}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .ig {
    margin-top: 24px;
  }

  .groups {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  .group {
    padding: 28px;
  }

  .group h2 {
    font-size: var(--step-2);
  }

  .group ul {
    list-style: none;
    padding: 0;
    margin: 0;
    columns: 2;
    column-gap: 24px;
  }

  .group li {
    display: flex;
    gap: 8px;
    align-items: baseline;
    padding: 6px 0;
    break-inside: avoid;
    color: var(--ink-2);
  }

  .group svg {
    color: var(--gold);
    flex: none;
    transform: translateY(3px);
  }

  .fb {
    margin: 0;
    padding: 26px;
  }

  .fb blockquote {
    margin: 0 0 16px;
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.4;
    color: var(--navy-900);
  }

  .fb figcaption {
    font-size: 0.9rem;
    color: var(--ink-3);
  }

  @media (max-width: 860px) {
    .groups {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .group ul {
      columns: 1;
    }
  }
</style>
