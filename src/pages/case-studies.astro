---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { caseStudies, testimonials } from '../data/content';
import { results } from '../data/categories';
import { clinic } from '../data/clinic';
const total = caseStudies.reduce((n, g) => n + g.items.length, 0);
---

<Base
  title="Before and After Results"
  description="Before and after photographs from The Derma House, Kaithal, and the laser, skin surgery, hair and anti-ageing cases the clinic treats."
>
  <PageHero
    title="Before and after"
    lede="Cases The Derma House has photographed and published. Results vary from person to person."
    crumbs={[{ label: 'Before and after' }]}
    image={results[1].src}
    imageAlt={results[1].alt}
    imageSize={[1400, 1050]}
  >
    <p><a class="text-link" href={clinic.social.instagram} target="_blank" rel="noopener">More on the clinic’s Instagram</a></p>
  </PageHero>

  <section class="section">
    <div class="container">
      <div class="pairs">
        {
          results.filter((_, n) => n !== 1).map((r, i) => (
            <figure class="photo pairs__item reveal" style={`--i:${i}`}>
              <img src={r.src} alt={r.alt} width="1400" height="1050" loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section well">
    <div class="container">
      <div class="head head--split">
        <h2>{total} case types, by speciality</h2>
        <p class="lead">Conditions the clinic’s case studies cover.</p>
      </div>
      <div class="groups">
        {
          caseStudies.map((g) => (
            <section class="group">
              <h3>{g.group}</h3>
              <ul>
                {g.items.map((i) => (
                  <li>{i}</li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="head">
        <h2>Patient comments</h2>
      </div>
      <div class="quotes">
        {
          testimonials.map((t) => (
            <figure class="quote">
              <blockquote>“{t.quote}”</blockquote>
              <figcaption>
                {t.name}, {t.treatment.toLowerCase()}
              </figcaption>
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .pairs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap-columns);
  }

  .pairs__item {
    aspect-ratio: 4 / 3;
  }

  .groups {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-xl) var(--gap-columns);
  }

  .group {
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-ink);
  }

  .group h3 {
    margin-bottom: var(--space-md);
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-title);
  }

  .group ul {
    display: grid;
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    list-style: none;
    color: var(--color-ink-2);
  }

  .quotes {
    border-bottom: 1px solid var(--color-rule);
  }

  .quote {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
    gap: var(--space-md) var(--gap-columns);
    align-items: end;
    margin: 0;
    padding-block: var(--space-xl);
    border-top: 1px solid var(--color-rule);
  }

  .quote blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-xl);
    line-height: 1.35;
    hanging-punctuation: first;
  }

  .quote figcaption {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  @media (max-width: 60rem) {
    .groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 40rem) {
    .pairs,
    .groups,
    .quote {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
