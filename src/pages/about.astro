---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import { benefits, aboutFaq } from '../data/content';
import { categories, img, treatments } from '../data/categories';
import { clinic } from '../data/clinic';
---

<Base
  title="About The Derma House"
  description="Dr. Aanchal S. Kakkar's The Derma House is a skin, laser and hair transplant clinic on Karnal Road, Kaithal, operated by Kakkar Healthcare."
>
  <PageHero
    title="A skin clinic on Karnal Road, Kaithal"
    lede={`Led by ${clinic.founder} and run by ${clinic.legalName}.`}
    crumbs={[{ label: 'About' }]}
    image={img.transplant}
    imageAlt="A hair transplant procedure under way"
    imageSize={[1280, 670]}
  />

  <section class="section">
    <div class="container about">
      <div class="about__text">
        <h2>How the clinic works</h2>
        <p class="lead">
          The Derma House offers {treatments.length} treatments across dermatology, lasers, hair restoration, anti-ageing,
          permanent makeup and minor skin surgery, with a clinical nutritionist on the team.
        </p>
        <p>
          Every treatment starts with a consultation, in the clinic or by video, so you know what is involved before you
          begin. The clinic says it has treated thousands of patients.
        </p>
      </div>
      <dl class="about__rows">
        {
          benefits.map((b) => (
            <div>
              <dt>{b.title}</dt>
              <dd>{b.body}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section well">
    <div class="container">
      <div class="head">
        <h2>Seven specialities and hair transplant</h2>
      </div>
      <ul class="specs">
        {
          categories.map((c) => (
            <li>
              <a class="specs__name" href={`/${c.slug}/`}>
                {c.title}
              </a>
              <p>{c.intro}</p>
            </li>
          ))
        }
        <li>
          <a class="specs__name" href="/hair-transplant/">Hair Transplant</a>
          <p>Male, female, beard and eyebrow hair transplants.</p>
        </li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container faq-grid">
      <h2>Questions about the clinic</h2>
      <FaqList items={aboutFaq} />
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    gap: var(--space-3xl);
    align-items: start;
  }

  .about__text {
    display: grid;
    gap: var(--space-lg);
  }

  .about__rows {
    margin: 0;
    border-top: 1px solid var(--color-rule);
  }

  .about__rows div {
    padding-block: var(--space-lg);
    border-bottom: 1px solid var(--color-rule);
  }

  .about__rows dt {
    font-family: var(--font-display);
    font-size: var(--text-title);
  }

  .about__rows dd {
    margin: var(--space-2xs) 0 0;
    color: var(--color-ink-2);
  }

  .specs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 var(--gap-columns);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .specs li {
    display: grid;
    gap: var(--space-xs);
    padding-block: var(--space-lg);
    border-top: 1px solid var(--color-rule);
  }

  .specs__name {
    font-family: var(--font-display);
    font-size: var(--text-title);
    color: var(--color-ink);
    text-decoration: none;
  }

  .specs__name:hover {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  .specs p {
    color: var(--color-ink-2);
  }

  .faq-grid {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: var(--space-xl) var(--gap-columns);
    align-items: start;
  }

  @media (max-width: 60rem) {
    .about,
    .faq-grid,
    .specs {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
