---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import BookingForm from '../components/BookingForm.astro';
import FaqList from '../components/FaqList.astro';
import { categories, treatments, treatmentsIn, img, results } from '../data/categories';
import { clinic, fullAddress, whatsappLink } from '../data/clinic';
import { concerns, homeFaq, nutritionist, bookingFacts } from '../data/content';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: homeFaq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

const week = [
  { day: 'Monday', short: 'Mon', open: true },
  { day: 'Tuesday', short: 'Tue', open: true },
  { day: 'Wednesday', short: 'Wed', open: true },
  { day: 'Thursday', short: 'Thu', open: true },
  { day: 'Friday', short: 'Fri', open: true },
  { day: 'Saturday', short: 'Sat', open: true },
  { day: 'Sunday', short: 'Sun', open: false },
];
---

<Base
  title="The Derma House | Dermatologist & Skin Clinic in Kaithal"
  description="Dr. Aanchal S. Kakkar's The Derma House in Kaithal: skin, laser, hair, anti-ageing and minor skin surgery. Book a consultation by phone, WhatsApp or online."
  schema={[faqSchema]}
>
  <!-- Hero: Stage -->
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__text">
        <h1>Skin and hair doctors in Kaithal.</h1>
        <p class="lead">Dr. Aanchal S. Kakkar’s clinic on Karnal Road, opposite SBI Bank.</p>
        <div class="hero__actions">
          <a class="btn" href="/book-consultation/"><Icon name="calendar" /> Book a consultation</a>
          <a class="btn btn--quiet" href={`tel:${clinic.phoneE164}`}><Icon name="phone" /> {clinic.phoneDisplay}</a>
        </div>
      </div>
      <figure class="photo hero__photo" data-slot="hero" data-alt="A treatment in progress at The Derma House">
        <img
          src={img.hero}
          alt="A clinician treating a patient’s forehead with a microneedling pen"
          width="1200"
          height="1200"
          fetchpriority="high"
        />
      </figure>
    </div>
  </section>

  <!-- Signature: the treatment menu, switched by speciality -->
  <section class="section menu" aria-labelledby="menu-h">
    <div class="container">
      <div class="head head--split">
        <h2 id="menu-h">{treatments.length} treatments, seven specialities</h2>
        <p class="lead">Pick a speciality to see what it covers and who it is for.</p>
      </div>

      <div class="menu__tabs" role="tablist" aria-label="Specialities" data-tabs>
        {
          categories.map((c, i) => (
            <a
              class="menu__tab"
              href={`/${c.slug}/`}
              role="tab"
              id={`tab-${c.slug}`}
              aria-controls={`panel-${c.slug}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              data-tab={c.slug}
            >
              {c.title}
            </a>
          ))
        }
      </div>

      {
        categories.map((c, i) => (
          <div
            class="menu__panel"
            role="tabpanel"
            id={`panel-${c.slug}`}
            aria-labelledby={`tab-${c.slug}`}
            data-panel={c.slug}
            hidden={i !== 0}
          >
            <div class="menu__side">
              <p class="menu__intro">{c.intro}</p>
              <a class="text-link" href={`/${c.slug}/`}>
                More about {c.title.toLowerCase()}
              </a>
              <figure class="photo menu__photo">
                <img src={c.image} alt={c.imageAlt} width="600" height="600" loading="lazy" decoding="async" />
              </figure>
            </div>
            <ul class="menu__rows">
              {treatmentsIn(c.slug).map((t) => (
                <li>
                  <a class="menu__name" href={`/${t.slug}/`}>
                    {t.title}
                  </a>
                  <span class="menu__for">{t.indications.length ? t.indications.join(', ') : t.summary}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }

      <div class="menu__more">
        <p class="label">Common concerns</p>
        <ul class="chips">
          {concerns.map((c) => <li><a class="chip" href={c.href}>{c.label}</a></li>)}
          <li><a class="chip" href="/hair-transplant/">Hair transplant</a></li>
          <li><a class="chip" href="/treatments/">All treatments</a></li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Results: the clinic's own before-and-after photographs -->
  <section class="section well results" aria-labelledby="results-h">
    <div class="container">
      <div class="head head--split">
        <h2 id="results-h">Before and after, from this clinic</h2>
        <p class="lead">Four cases The Derma House has published. Results vary from person to person.</p>
      </div>
      <div class="results__grid">
        {
          results.map((r, i) => (
            <figure class="photo results__item reveal" style={`--i:${i}`}>
              <img src={r.src} alt={r.alt} width="1400" height="1050" loading="lazy" decoding="async" />
            </figure>
          ))
        }
      </div>
      <p class="results__more">
        <a class="text-link" href="/case-studies/">Cases the clinic treats</a>
        <a class="text-link" href={clinic.social.instagram} target="_blank" rel="noopener">More results on Instagram</a>
      </p>
    </div>
  </section>

  <!-- Nutritionist, on the navy band -->
  <section class="section band nutri" aria-labelledby="nutri-h">
    <div class="container nutri__grid">
      <figure class="photo nutri__photo" data-slot="nutritionist" data-alt="Dt. Maheep Dhaliwal at The Derma House">
        <img src={img.nutritionist} alt="Dt. Maheep Dhaliwal in a white coat at the clinic" width="900" height="1352" loading="lazy" />
      </figure>
      <div class="nutri__text">
        <h2 id="nutri-h">{nutritionist.name}, clinical nutritionist</h2>
        <p class="nutri__role">{nutritionist.qualification}</p>
        <p class="lead">{nutritionist.bio}</p>
        <div class="hero__actions">
          <a class="btn" href="/food-nutrition/">Nutrition at the clinic</a>
          <a class="btn btn--quiet" href={whatsappLink('Hello, I would like to book a nutrition consultation.')} target="_blank" rel="noopener">
            Book a nutrition consult
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Booking -->
  <section class="section book" id="book" aria-labelledby="book-h">
    <div class="container book__grid">
      <div class="book__text">
        <h2 id="book-h">Book a consultation</h2>
        <p class="lead">Tell us your concern. The clinic confirms a time by phone or WhatsApp.</p>
        <dl class="book__facts">
          {
            bookingFacts.map((f) => (
              <div>
                <dt>{f.term}</dt>
                <dd>{f.detail}</dd>
              </div>
            ))
          }
        </dl>
        <p class="muted">
          Questions about the clinic first? <a class="text-link" href="/about/">About The Derma House</a>
        </p>
      </div>
      <BookingForm title="Your details" />
    </div>
  </section>

  <!-- FAQ as rows -->
  <section class="section well faq-sec" aria-labelledby="faq-h">
    <div class="container faq-sec__grid">
      <h2 id="faq-h">Five questions before you book</h2>
      <FaqList items={homeFaq} />
    </div>
  </section>

  <!-- Opening hours and address -->
  <section class="section visit" aria-labelledby="visit-h">
    <div class="container visit__grid">
      <div class="visit__text">
        <h2 id="visit-h">Opening hours</h2>
        <ol class="week" data-week>
          {
            week.map((d, i) => (
              <li class:list={['week__day', { 'week__day--closed': !d.open }]} data-day={(i + 1) % 7}>
                <span class="week__name">{d.day}</span>
                <span class="week__time">{d.open ? '10:00 AM to 7:00 PM' : 'Closed'}</span>
              </li>
            ))
          }
        </ol>
        <address class="visit__address">
          <strong>{clinic.name}</strong>
          <span>{fullAddress}</span>
          <a href={`tel:${clinic.phoneE164}`}>{clinic.phoneDisplay}</a>
          <a href={`mailto:${clinic.email}`}>{clinic.email}</a>
        </address>
        <div class="hero__actions">
          <a class="btn" href={clinic.mapsLink} target="_blank" rel="noopener"><Icon name="pin" /> Get directions</a>
          <a class="btn btn--quiet" href={whatsappLink()} target="_blank" rel="noopener"><Icon name="whatsapp" /> WhatsApp</a>
        </div>
      </div>
      <div class="visit__frame">
        <p class="visit__fallback">
          <span>{fullAddress}</span>
          <a class="text-link" href={clinic.mapsLink} target="_blank" rel="noopener">Open in Google Maps</a>
        </p>
        <iframe
          class="visit__map"
          title="Map showing The Derma House, Karnal Road, Kaithal"
          src={clinic.mapsEmbed}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </section>
</Base>

<script>
  // Treatment menu: links become tabs once script runs; without it each tab opens its category page.
  const tabs = [...document.querySelectorAll<HTMLAnchorElement>('[data-tab]')];
  const panels = [...document.querySelectorAll<HTMLElement>('[data-panel]')];

  function select(slug: string, focus = false) {
    tabs.forEach((t) => {
      const on = t.dataset.tab === slug;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      if (on && focus) t.focus();
    });
    panels.forEach((p) => (p.hidden = p.dataset.panel !== slug));
  }

  tabs.forEach((tab, i) => {
    tab.addEventListener('click', (e) => {
      e.preventDefault();
      select(tab.dataset.tab ?? '');
    });
    tab.addEventListener('keydown', (e) => {
      const keys: Record<string, number> = { ArrowRight: 1, ArrowLeft: -1 };
      if (e.key in keys) {
        e.preventDefault();
        const next = tabs[(i + keys[e.key] + tabs.length) % tabs.length];
        select(next.dataset.tab ?? '', true);
      } else if (e.key === 'Home' || e.key === 'End') {
        e.preventDefault();
        const next = e.key === 'Home' ? tabs[0] : tabs[tabs.length - 1];
        select(next.dataset.tab ?? '', true);
      }
    });
  });

  // Opening hours: mark today.
  const today = new Date().getDay();
  document.querySelector(`[data-week] [data-day="${today}"]`)?.setAttribute('aria-current', 'date');
</script>

<style>
  /* Hero: Stage, text on five columns, the photograph on seven */
  .hero {
    padding-block: var(--space-2xl);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-3xl);
    align-items: center;
    min-height: calc(100svh - var(--nav-h) - 2 * var(--space-2xl));
  }

  .hero__text {
    display: grid;
    gap: var(--space-lg);
  }

  .hero h1 {
    max-width: 11ch;
    text-wrap: balance;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
    margin-top: var(--space-xs);
  }

  .hero__photo {
    aspect-ratio: 5 / 4;
    max-height: 72svh;
    width: 100%;
  }

  .hero__photo img {
    object-position: 50% 35%;
  }

  @media (max-width: 60rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-xl);
      min-height: 0;
    }

    .hero__photo {
      aspect-ratio: 4 / 3;
    }
  }

  /* Treatment menu */
  .menu__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2xs) var(--space-lg);
    border-bottom: 1px solid var(--color-rule);
  }

  .menu__tab {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding-block: var(--space-xs);
    color: var(--color-muted);
    font-size: var(--text-md);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--dur-short) var(--ease-out);
  }

  .menu__tab::after {
    content: '';
    position: absolute;
    inset: auto 0 -1px 0;
    height: 2px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-short) var(--ease-out);
  }

  .menu__tab:hover {
    color: var(--color-ink);
  }

  .menu__tab:active {
    color: var(--color-accent-deep);
  }

  .menu__tab[aria-selected='true'] {
    color: var(--color-ink);
    font-weight: 700;
  }

  .menu__tab[aria-selected='true']::after {
    transform: scaleX(1);
  }

  .menu__panel {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: var(--space-xl) var(--gap-columns);
    align-items: start;
    padding-top: var(--space-xl);
  }

  .menu__side {
    display: grid;
    gap: var(--space-md);
    justify-items: start;
  }

  .menu__photo {
    width: 100%;
    aspect-ratio: 1;
    margin-top: var(--space-xs);
  }

  .menu__intro {
    font-size: var(--text-lead);
    line-height: 1.45;
    color: var(--color-ink-2);
  }

  .menu__rows {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-rule);
  }

  .menu__rows li {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-2xs) var(--gap-columns);
    align-items: baseline;
    padding-block: var(--space-md);
    border-bottom: 1px solid var(--color-rule);
  }

  .menu__name {
    font-family: var(--font-display);
    font-size: var(--text-title);
    line-height: 1.2;
    color: var(--color-ink);
    text-decoration: none;
  }

  .menu__name:hover {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  .menu__for {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .menu__more {
    display: grid;
    gap: var(--space-sm);
    margin-top: var(--space-2xl);
  }

  @media (max-width: 60rem) {
    .menu__tabs {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: thin;
      padding-right: var(--space-2xl);
      mask-image: linear-gradient(to right, var(--color-ink) 78%, transparent);
    }

    .menu__photo {
      display: none;
    }

    .menu__panel,
    .menu__rows li {
      grid-template-columns: minmax(0, 1fr);
    }

  }

  /* Results */
  .results__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gap-columns);
  }

  .results__item {
    aspect-ratio: 4 / 3;
  }

  .results__more {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-xl);
    margin-top: var(--space-xl);
  }

  @media (max-width: 40rem) {
    .results__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Nutritionist */
  .nutri__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-3xl);
    align-items: center;
  }

  .nutri__photo {
    aspect-ratio: 4 / 5;
    max-height: 640px;
  }

  .nutri__photo img {
    object-position: 50% 20%;
    outline-color: color-mix(in oklab, var(--color-field-ink) 12%, transparent);
  }

  .nutri__text {
    display: grid;
    gap: var(--space-lg);
  }

  .nutri__text h2 {
    overflow-wrap: break-word;
    min-width: 0;
  }

  .nutri__role {
    color: var(--color-seal);
    font-weight: 700;
  }

  @media (max-width: 60rem) {
    .nutri__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-xl);
    }

    .nutri__photo {
      max-width: 420px;
    }
  }

  /* Booking */
  .book__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: var(--space-3xl);
    align-items: start;
  }

  .book__text {
    display: grid;
    gap: var(--space-lg);
  }

  .book__facts {
    margin: var(--space-xs) 0 0;
    border-top: 1px solid var(--color-rule);
  }

  .book__facts div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
    gap: var(--space-md);
    padding-block: var(--space-md);
    border-bottom: 1px solid var(--color-rule);
  }

  .book__facts dt {
    font-weight: 700;
  }

  .book__facts dd {
    margin: 0;
    color: var(--color-ink-2);
  }

  @media (max-width: 60rem) {
    .book__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-xl);
    }
  }

  /* FAQ */
  .faq-sec__grid {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: var(--space-xl) var(--gap-columns);
    align-items: start;
  }

  @media (max-width: 60rem) {
    .faq-sec__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* Opening hours */
  .visit__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-3xl);
    align-items: stretch;
  }

  .visit__text {
    display: grid;
    gap: var(--space-lg);
    align-content: start;
  }

  .week {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-rule);
  }

  .week__day {
    display: flex;
    justify-content: space-between;
    gap: var(--space-md);
    padding-block: var(--space-sm);
    border-bottom: 1px solid var(--color-rule);
    font-variant-numeric: tabular-nums;
  }

  .week__day--closed {
    color: var(--color-muted);
  }

  .week__day[aria-current='date'] {
    font-weight: 700;
    color: var(--color-accent);
  }

  .visit__address {
    display: grid;
    gap: var(--space-2xs);
    font-style: normal;
    color: var(--color-ink-2);
  }

  .visit__address a {
    color: var(--color-accent);
  }

  .visit__frame {
    position: relative;
    min-height: 480px;
    border-radius: var(--radius-card);
    background: var(--color-paper-2);
    overflow: hidden;
  }

  .visit__fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    gap: var(--space-xs);
    padding: var(--space-xl);
    text-align: center;
    color: var(--color-ink-2);
  }

  .visit__map {
    position: relative;
    z-index: var(--z-base);
    display: block;
    width: 100%;
    height: 100%;
    min-height: 480px;
    border: 0;
    background: transparent;
  }

  @media (max-width: 60rem) {
    .visit__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-xl);
    }

    .visit__frame,
    .visit__map {
      min-height: 320px;
    }
  }
</style>
