---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import BookingForm from '../components/BookingForm.astro';
import Icon from '../components/Icon.astro';
import { process } from '../data/content';
import { clinic } from '../data/clinic';
---

<Base
  title="Book a Skin & Hair Consultation"
  description="Book an in-clinic or online consultation with The Derma House dermatologists in Kaithal. We confirm your appointment within 24 hours."
>
  <PageHero
    title="Book your consultation"
    eyebrow="In-clinic or online"
    lede="Get expert guidance for your skin, hair and aesthetic concerns. Fill the quick form and our team will contact you within 24 hours to confirm your appointment."
    crumbs={[{ label: 'Book consultation' }]}
  />

  <section class="section">
    <div class="wrap split">
      <BookingForm title="Request an appointment" />
      <div>
        <h2>What happens next</h2>
        <ol class="next">
          {
            process.map((s, i) => (
              <li>
                <span class="next__num">{i + 1}</span>
                <div>
                  <h3>{s.title}</h3>
                  <p>{s.body}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <div class="card info">
          <p><Icon name="clock" /> {clinic.hours.label} · {clinic.hours.note}</p>
          <p><Icon name="video" /> Online video consultations available</p>
          <p><Icon name="phone" /> Prefer to call? <a href={`tel:${clinic.phoneE164}`}>{clinic.phoneDisplay}</a></p>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
  }

  .next {
    list-style: none;
    padding: 0;
    margin: 24px 0 32px;
    display: grid;
    gap: 20px;
  }

  .next li {
    display: grid;
    grid-template-columns: 40px 1fr;
    gap: 16px;
  }

  .next__num {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--navy);
    color: var(--white);
    font-weight: 700;
  }

  .next h3 {
    margin-bottom: 4px;
  }

  .next p {
    margin: 0;
    color: var(--ink-2);
  }

  .info {
    padding: 20px 24px;
    display: grid;
    gap: 10px;
  }

  .info p {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    color: var(--ink-2);
  }

  .info svg {
    color: var(--gold);
    flex: none;
  }

  @media (max-width: 900px) {
    .split {
      grid-template-columns: 1fr;
    }
  }
</style>
