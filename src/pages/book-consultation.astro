---
import Base from '../layouts/Base.astro';
import BookingForm from '../components/BookingForm.astro';
import { process, bookingFacts } from '../data/content';
import { clinic } from '../data/clinic';
---

<Base
  title="Book a Skin & Hair Consultation"
  description="Book an in-clinic or video consultation with The Derma House in Kaithal. The clinic confirms your appointment within 24 hours."
>
  <section class="book">
    <div class="container book__grid">
      <div class="book__text">
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            <li><span aria-current="page">Book a consultation</span></li>
          </ol>
        </nav>
        <h1>Book a consultation</h1>
        <p class="lead">In the clinic or by video. The Derma House confirms your time within 24 hours.</p>
        <dl class="facts">
          {
            bookingFacts.map((f) => (
              <div>
                <dt>{f.term}</dt>
                <dd>{f.detail}</dd>
              </div>
            ))
          }
          <div>
            <dt>Hours</dt>
            <dd>{clinic.hours.label}. {clinic.hours.note}.</dd>
          </div>
          <div>
            <dt>Phone</dt>
            <dd><a href={`tel:${clinic.phoneE164}`}>{clinic.phoneDisplay}</a></dd>
          </div>
        </dl>
      </div>
      <BookingForm title="Request an appointment" />
    </div>
  </section>

  <section class="section well">
    <div class="container">
      <h2 class="next__h">What happens next</h2>
      <ol class="next">
        {
          process.map((s) => (
            <li>
              <h3>{s.title}</h3>
              <p>{s.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
</Base>

<style>
  .book {
    padding-block: var(--space-3xl);
  }

  .book__grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: var(--space-3xl);
    align-items: start;
  }

  .book__text {
    display: grid;
    gap: var(--space-lg);
  }

  .crumbs ol {
    display: flex;
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .crumbs li + li::before {
    content: '/';
    margin-right: var(--space-xs);
  }

  .crumbs a {
    color: var(--color-ink-2);
  }

  .facts {
    margin: 0;
    border-top: 1px solid var(--color-rule);
  }

  .facts div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 3fr);
    gap: var(--space-md);
    padding-block: var(--space-md);
    border-bottom: 1px solid var(--color-rule);
  }

  .facts dt {
    font-weight: 700;
  }

  .facts dd {
    margin: 0;
    color: var(--color-ink-2);
  }

  .facts a {
    color: var(--color-accent);
  }

  .next__h {
    margin-bottom: var(--space-2xl);
  }

  .next {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--gap-columns);
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
  }

  .next li {
    display: grid;
    gap: var(--space-xs);
    align-content: start;
    padding-top: var(--space-lg);
    border-top: 1px solid var(--color-ink);
    counter-increment: step;
  }

  .next li::before {
    content: counter(step);
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    line-height: 1;
    color: var(--color-accent);
  }

  .next p {
    color: var(--color-ink-2);
  }

  @media (max-width: 60rem) {
    .book__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-xl);
    }

    .next {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-xl) var(--gap-columns);
    }
  }

  @media (max-width: 40rem) {
    .next {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
