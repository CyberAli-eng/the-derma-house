---
import Base from '../layouts/Base.astro';
import BookingForm from '../components/BookingForm.astro';
import FaqList from '../components/FaqList.astro';
import Icon from '../components/Icon.astro';
import CtaBand from '../components/CtaBand.astro';
import { contactFaq } from '../data/content';
import { clinic, fullAddress, whatsappLink } from '../data/clinic';

const ways = [
  { icon: 'phone', title: 'Call', label: clinic.phoneDisplay, href: `tel:${clinic.phoneE164}` },
  { icon: 'whatsapp', title: 'WhatsApp', label: 'Message the clinic', href: whatsappLink() },
  { icon: 'mail', title: 'Email', label: clinic.email, href: `mailto:${clinic.email}` },
  { icon: 'pin', title: 'Visit', label: 'Get directions', href: clinic.mapsLink },
] as const;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: contactFaq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Base
  title="Contact & Directions"
  description={`Contact The Derma House, ${fullAddress}. Call ${clinic.phoneDisplay}, WhatsApp the clinic or visit ${clinic.hours.label}.`}
  schema={[faqSchema]}
>
  <section class="contact-sec">
    <div class="container contact">
      <div class="contact__text">
        <nav class="crumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            <li><span aria-current="page">Contact</span></li>
          </ol>
        </nav>
        <h1>Contact the clinic</h1>
        <p class="lead">Call, WhatsApp, email or visit us at {fullAddress}. We reply within 24 hours.</p>
      <ul class="ways">
        {
          ways.map((w) => (
            <li>
              <span class="ways__title">
                <Icon name={w.icon} size={20} /> {w.title}
              </span>
              <a
                class="ways__link"
                href={w.href}
                target={w.href.startsWith('http') ? '_blank' : undefined}
                rel={w.href.startsWith('http') ? 'noopener' : undefined}
              >
                {w.label}
              </a>
            </li>
          ))
        }
        <li>
          <span class="ways__title"><Icon name="clock" size={20} /> Hours</span>
          <span>{clinic.hours.label}. {clinic.hours.note}.</span>
        </li>
      </ul>
      </div>
      <div class="frame">
        <p class="frame__fallback">
          <span>{fullAddress}</span>
          <a class="text-link" href={clinic.mapsLink} target="_blank" rel="noopener">Open in Google Maps</a>
        </p>
        <iframe class="map" title="Map showing The Derma House, Kaithal" src={clinic.mapsEmbed} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </section>

  <section class="section well">
    <div class="container split">
      <div class="split__text">
        <h2>Send a question</h2>
        <p class="lead">Tell us what you would like to ask and the best number to reach you on.</p>
      </div>
      <BookingForm title="Your question" />
    </div>
  </section>

  <section class="section">
    <div class="container faq-grid">
      <h2>Before you call</h2>
      <FaqList items={contactFaq} />
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .contact-sec {
    padding-block: var(--space-2xl);
  }

  .contact {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    gap: var(--space-3xl);
    align-items: stretch;
    min-height: calc(100svh - var(--nav-h) - 2 * var(--space-2xl));
  }

  .contact__text {
    display: grid;
    gap: var(--space-lg);
    align-content: center;
  }

  .crumbs ol {
    display: flex;
    gap: var(--space-xs);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
    color: var(--color-muted);
  }

  .crumbs li + li::before {
    content: '/';
    margin-right: var(--space-xs);
  }

  .crumbs a {
    color: var(--color-ink-2);
  }

  .ways {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--color-rule);
  }

  .ways li {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 5fr);
    gap: var(--space-md);
    align-items: center;
    min-height: 72px;
    padding-block: var(--space-md);
    border-bottom: 1px solid var(--color-rule);
    color: var(--color-ink-2);
  }

  .ways__title {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-weight: 700;
    color: var(--color-ink);
  }

  .ways__link {
    color: var(--color-accent);
    overflow-wrap: anywhere;
  }

  .map.is-focused,
  .map:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
  }

  .frame {
    position: relative;
    min-height: 460px;
    border-radius: var(--radius-card);
    background: var(--color-paper-2);
    overflow: hidden;
  }

  .frame__fallback {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    gap: var(--space-xs);
    padding: var(--space-xl);
    text-align: center;
    color: var(--color-ink-2);
  }

  .map {
    position: relative;
    z-index: var(--z-base);
    display: block;
    width: 100%;
    height: 100%;
    min-height: 460px;
    border: 0;
    background: transparent;
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: var(--space-3xl);
    align-items: start;
  }

  .split__text {
    display: grid;
    gap: var(--space-lg);
  }

  .faq-grid {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: var(--space-xl) var(--gap-columns);
    align-items: start;
  }

  @media (max-width: 60rem) {
    .contact,
    .split,
    .faq-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-xl);
    }

    .frame,
    .map {
      min-height: 320px;
    }
  }

  @media (max-width: 40rem) {
    .ways li {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-2xs);
    }
  }
</style>
