---
import Base from '../layouts/Base.astro';
import { clinic, whatsappLink } from '../data/clinic';
---

<Base title="Thank you" description="Your consultation request is ready to send to The Derma House on WhatsApp." noindex>
  <section class="section">
    <div class="container ty">
      <h1>Your request is ready in WhatsApp</h1>
      <p class="lead">Press send there and the clinic will confirm your appointment within 24 hours ({clinic.hours.label}).</p>
      <p>WhatsApp did not open? Use the button below, or call <a class="text-link" href={`tel:${clinic.phoneE164}`}>{clinic.phoneDisplay}</a>.</p>
      <div class="ty__actions">
        <a class="btn" href={whatsappLink()} target="_blank" rel="noopener" data-wa-retry>Send on WhatsApp</a>
        <a class="btn btn--quiet" href="/treatments/">See all treatments</a>
        <a class="btn btn--quiet" href="/">Home</a>
      </div>
    </div>
  </section>
</Base>

<script>
  try {
    const url = sessionStorage.getItem('tdh-booking-wa');
    const link = document.querySelector<HTMLAnchorElement>('[data-wa-retry]');
    if (url && link && url.startsWith('https://wa.me/')) link.href = url;
  } catch {
    /* storage unavailable: keep the generic WhatsApp link */
  }
</script>

<style>
  .ty {
    display: grid;
    gap: var(--space-lg);
    min-height: 50svh;
    align-content: center;
  }

  .ty__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
</style>
