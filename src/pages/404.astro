---
import Base from '../layouts/Base.astro';
import { concerns } from '../data/content';
---

<Base title="Page not found" description="That page has moved. Find a treatment or book a consultation at The Derma House, Kaithal." noindex>
  <section class="section">
    <div class="container nf">
      <h1>That page has moved</h1>
      <p class="lead">The site was rebuilt and some addresses changed. These are the treatments people look for most.</p>
      <ul class="chips">
        {concerns.map((c) => <li><a class="chip" href={c.href}>{c.label}</a></li>)}
      </ul>
      <div class="nf__actions">
        <a class="btn" href="/treatments/">All treatments</a>
        <a class="btn btn--quiet" href="/">Home</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .nf {
    display: grid;
    gap: var(--space-lg);
    min-height: 50svh;
    align-content: center;
  }

  .nf__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
</style>
